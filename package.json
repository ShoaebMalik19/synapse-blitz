{
  "name": "synapse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "service": "tsx services/paid-data/server.ts",
    "orchestrator": "tsx scripts/orchestrator.ts",
    "worker:a": "tsx scripts/supervise.ts worker-a",
    "worker:b": "tsx scripts/supervise.ts worker-b",
    "backend": "concurrently -k -n service,orch,workerA,workerB -c blue,magenta,cyan,yellow \"npm:service\" \"npm:orchestrator\" \"npm:worker:a\" \"npm:worker:b\"",
    "dev:all": "concurrently -k -n web,service,orch,workerA,workerB -c gray,blue,magenta,cyan,yellow \"npm:dev\" \"npm:service\" \"npm:orchestrator\" \"npm:worker:a\" \"npm:worker:b\"",
    "start:all": "concurrently -k -n web,service,orch,workerA,workerB -c gray,blue,magenta,cyan,yellow \"npm:start\" \"npm:service\" \"npm:orchestrator\" \"npm:worker:a\" \"npm:worker:b\"",
    "deploy:escrow": "tsx scripts/deploy-escrow.ts",
    "status": "tsx scripts/status.ts",
    "smoke": "tsx scripts/smoke.ts --drill",
    "test": "vitest run",
    "test:contracts": "cd contracts && forge test -vv",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@x402/core": "^2.29.0",
    "@x402/evm": "^2.29.0",
    "@x402/express": "^2.29.0",
    "@x402/fetch": "^2.29.0",
    "@xyflow/react": "^12.12.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
