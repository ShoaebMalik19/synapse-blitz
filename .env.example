# ============================================================================
# SYNAPSE — environment template. Copy to .env and fill in. NEVER commit .env.
# All keys below are for DEDICATED, LOW-VALUE TESTNET wallets only.
# Generate fresh ones with:  npm run wallets:new   (prints addresses only)
# ============================================================================

# ---- Monad testnet (verified live: eth_chainId = 0x279f = 10143) ----
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
# Filled automatically by `npm run deploy:escrow` (also written to deployments/monad-testnet.json)
MONAD_ESCROW_ADDRESS=
MONAD_TESTNET_EXPLORER_URL=https://testnet.monadvision.com

# ---- x402 (verified: facilitator /supported lists exact @ eip155:10143, x402Version 2) ----
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
X402_NETWORK_ID=eip155:10143
# Circle USDC on Monad TESTNET (6 decimals, EIP-3009). Never use a mainnet address here.
X402_ASSET_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
# Address that receives x402 payments for the paid research data service
X402_PAY_TO=
X402_SERVICE_URL=http://localhost:4021
X402_SERVICE_PORT=4021

# ---- LLM planner/analyst (any OpenAI-compatible chat-completions API). Optional. ----
# Verified with Groq: LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-20b
# (openai/gpt-oss-120b also works). Other providers: OpenAI, OpenRouter, Together, local servers.
# If empty or the provider fails (HTTP 429/401/404, timeout, invalid output), Synapse falls back to its
# deterministic rule-based planner and labels the draft "Rule-based fallback" with the reason.
# The key is only used server-side in the Authorization header; it is never logged or sent to the browser.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Optional for reasoning models (low|medium|high); leave empty for providers that don't support it
LLM_REASONING_EFFORT=

# ---- Persistence / auth ----
DATABASE_URL=file:./data/synapse.db
# Random 32+ byte hex used to sign the operator session cookie
SESSION_SECRET=
# Token the single operator types into /login to obtain a session
OPERATOR_ACCESS_TOKEN=

# ---- Server-side signing keys (testnet only; never exposed to the browser) ----
# Operator: deploys TaskEscrow, requester/verifier for escrow, x402 payer (needs MON + testnet USDC)
OPERATOR_PRIVATE_KEY=
OPERATOR_ADDRESS=
# Worker payees: submit result hashes on-chain (operator tops them up with a little MON for gas)
WORKER_A_PRIVATE_KEY=
WORKER_A_ADDRESS=
WORKER_B_PRIVATE_KEY=
WORKER_B_ADDRESS=
# Paid data provider (receives x402 USDC). Only the address is needed by the service.
PROVIDER_PRIVATE_KEY=
PROVIDER_ADDRESS=

# ---- Budget policy defaults (per workflow; user may lower them in the dashboard) ----
POLICY_MAX_X402_USDC=0.05
POLICY_MAX_PER_CALL_USDC=0.02
POLICY_APPROVAL_THRESHOLD_USDC=0.015
POLICY_MAX_ESCROW_MON=0.01
POLICY_MAX_GAS_MON=0.05
